};

class HistoryNode{
    public:
        History data;
        HistoryNode* next;

        HistoryNode(History h) : data(h){
            next=NULL;
        }
};

class HistoryStack{
    public:
        HistoryNode* top;
        int count;

        HistoryStack(){
            top=NULL;
            count=0;
        }

        void push(History h){
            HistoryNode* n=new HistoryNode(h);
            n->next=top;
            top=n;
            count++;
        }

        void pop(){
            if(isEmpty()){
                cout<<"History is empty"<<endl;
                return;
            }
            HistoryNode* temp=top;
            top=top->next;
            delete temp;
            count--;
        }

        void peek(){
            if(isEmpty()){
                cout<<"History is empty"<<endl;
                return;
            }
            top->data.display();
        }

        void display(){
            HistoryNode* temp=top;
            while(temp!=NULL){
                temp->data.display();
                cout<<endl;
                temp=temp->next;
            }
        }

        bool isEmpty(){
            return top==NULL;
        }
};

