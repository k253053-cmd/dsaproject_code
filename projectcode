void deleteorg(int id){
    node* temp = head;
    node* pre = NULL;

    while(temp){
        if(temp->data.id == id){

            if(head == tail){
                head = NULL;
                tail = NULL;
            }
            else if(temp == head){
                head = head->next;
            }
            else if(temp == tail){
                tail = pre;
                tail->next = NULL;
            }
            else{
                pre->next = temp->next;
            }

            delete temp;
            count--;

            cout<<"Deleted Successfully"<<endl;
            return;
        }

        pre = temp;
        temp = temp->next;
    }

    cout<<"No such id found"<<endl;
}
